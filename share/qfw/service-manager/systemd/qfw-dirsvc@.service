[Unit]
Description=QFw DEFw directory service instance %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
RuntimeDirectory=qfw/dirsvc-%i
ExecStart=/bin/bash -lc 'source /etc/openqse/qfw/env.sh && exec qfw-dir-svc run --scope site --run-dir "/run/qfw/dirsvc-%i" --site-config "${QFW_SITE_CONFIG}"'
Restart=on-failure
TimeoutStartSec=360

[Install]
WantedBy=multi-user.target
