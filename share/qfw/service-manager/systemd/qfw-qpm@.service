[Unit]
Description=QFw QPM service instance %i
After=network-online.target qfw-dirsvc@site.service
Wants=network-online.target

[Service]
Type=simple
Environment=QFW_QPM_SERVICE_ID=%i
EnvironmentFile=/etc/openqse/qfw/services/qpm/%i.env
RuntimeDirectory=qfw/qpm-%i
ExecStart=/bin/bash -lc 'source /etc/openqse/qfw/env.sh && exec qfw-qpm-svc run --scope site --run-dir "/run/qfw/qpm-%i" --service-id "${QFW_QPM_SERVICE_ID}" --site-config "${QFW_SITE_CONFIG}"'
Restart=on-failure
TimeoutStartSec=360

[Install]
WantedBy=multi-user.target
