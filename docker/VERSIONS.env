# Versions for docker build ARGs used by Dockerfile.builder and Dockerfile.qfw.
# Sourced by the Makefile (see docker-build target) as the single place
# to bump these versions. Plain KEY=VALUE so it can also be `source`d
# from a shell if needed.

ROCKYLINUX_VERSION=10.2
QRMI_VERSION=0.17.2
QDMI_VERSION=1.3.3
