# This directive guarantees environment consistency: It ensures that every
# developer and CI/CD pipeline building the image uses the exact same Dockerfile
# parser version, eliminating the "works on my machine" bug.
# It pulls the parser dynamically as a container image.
# Used in the RUN step to mount the directory.
#
# syntax=docker/dockerfile:1

# The qfw-builder image built from Dockerfile.builder. Must already exist
# locally (or be pullable) before building this image.
ARG BUILDER_IMAGE=qfw-builder:latest

FROM ${BUILDER_IMAGE}

LABEL org.opencontainers.image.title="qfw"
LABEL org.opencontainers.image.description="QRMI, QDMI, and QFw installed on top of the qfw-builder toolchain image"

# The top-level directory where all packages are installed
# Usually, it is /opt/qfw
ARG INSTALL_DIR

# ============================================================================
# Stage 1: Install QRMI
# ============================================================================

# The QRMI version (release tag) to use.
# Do not provide a default value to ensure explicit version is provided via
# the --build-arg during image build.
ARG QRMI_VERSION

# The TARGETARCH is a Docker BuildKit's automatic build argument.
# Used, among others, to determine the QRMI artifact flavor to download.
ARG TARGETARCH

# We need to download the correct TARGETARCH flavor of the QRMI tarball.
# So, detrmine the appropriate component of the artifact name based on the
# TARGETARCH as the QRMI_ARCH value. Then, resolve the full URL based on
# the provided QRMI_VERSION argument value.
# NOTE: The QRMI creates relese for RHEL8. We expect RockyLinux version 9
# or 10 (based on the ROCKYLINUX_TAG value), so hard-code "rl8" into the
# URL string when substituting the QRMI_ARCH and QRMI_VERSION.
RUN set -ex \
    && case "${TARGETARCH}" in \
    amd64) QRMI_ARCH=x86_64 ;; \
    arm64) QRMI_ARCH=aarch64 ;; \
    ppc64le) QRMI_ARCH=ppc64le ;; \
    *) echo "unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac \
    && mkdir -p "${INSTALL_DIR}/qrmi" \
    && curl -fsSL -o /tmp/qrmi.tar.gz \
    "https://github.com/qiskit-community/qrmi/releases/download/${QRMI_VERSION}/libqrmi-${QRMI_VERSION}-el8-${QRMI_ARCH}.tar.gz" \
    && tar -xzf /tmp/qrmi.tar.gz -C "${INSTALL_DIR}/qrmi" --strip-components=1 \
    && rm -f /tmp/qrmi.tar.gz

# ============================================================================
# Stage 2: Install QDMI
# ============================================================================

# The QDMI version (release tag) to use.
# Do not provide a default value to ensure explicit version is provided via
# the --build-arg during image build.
# Do not include the 'v' prefix, only the comma-separated numerals.
ARG QDMI_VERSION

# QDMI ships no prebuilt release artifacts (it's a header-only interface
# library), so unlike QRMI above we build and install it from source with
# CMake. Tests, examples, templates, and docs are disabled: they aren't
# needed to install the qdmi::qdmi interface library and would otherwise
# pull in extra dependencies (e.g. GoogleTest, Doxygen) fetched over the
# network during the CMake configure step.
RUN set -ex \
    && git clone --depth 1 --branch "v${QDMI_VERSION}" \
    https://github.com/Munich-Quantum-Software-Stack/QDMI.git /tmp/qdmi \
    && cmake -S /tmp/qdmi -B /tmp/qdmi/build \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX="${INSTALL_DIR}/qdmi" \
    -DINSTALL_QDMI=ON \
    -DBUILD_QDMI_TESTS=OFF \
    -DBUILD_QDMI_EXAMPLES=OFF \
    -DBUILD_QDMI_TEMPLATES=OFF \
    -DBUILD_QDMI_DOCS=OFF \
    && cmake --build /tmp/qdmi/build --target install \
    && rm -rf /tmp/qdmi

# ============================================================================
# Stage 3: Build QFw
# ============================================================================

# Extra dependencies needed only to build QFw and its bundled DEFw tree
# (not needed by the QRMI/QDMI stages above).
RUN set -ex \
    && dnf -y install \
    libuuid-devel \
    openblas-devel \
    python3-devel \
    swig \
    && dnf clean all \
    && rm -rf /var/cache/dnf

# Build and install QFw itself, following the "Build QFw" steps in
# README.md: create a venv, install the build/runtime Python requirements,
# then configure/build/install with CMake (equivalent to
# `./setup/qfw_install.sh --prefix ${INSTALL_DIR}/qfw --with-defw`).
#
# The repository is bind-mounted read-only at build time instead of being
# COPY-ed into the image, so the source tree (and its .git/submodule
# metadata) never ends up baked into an image layer -- only the installed
# QFw artifacts do. This means the image must be built with the QFw
# top-level directory as the build context, and submodules must already
# be initialized on the host (`git submodule update --init --recursive`)
# before building.
RUN --mount=type=bind,source=.,target=/workspace,ro set -ex \
    && python3 -m venv /opt/qfw-venv \
    && /opt/qfw-venv/bin/pip install --upgrade pip setuptools wheel \
    && /opt/qfw-venv/bin/pip install -r /workspace/setup/build-requirements.txt \
    && /opt/qfw-venv/bin/pip install -r /workspace/setup/requirements.txt \
    && source /opt/qfw-venv/bin/activate \
    && cmake -S /workspace -B /tmp/qfw-build \
    -DCMAKE_INSTALL_PREFIX="${INSTALL_DIR}/qfw" \
    -DQFW_BUILD_BUNDLED_DEFW=ON \
    && cmake --build /tmp/qfw-build \
    && cmake --install /tmp/qfw-build \
    && rm -rf /tmp/qfw-build

CMD ["sleep", "infinity"]
