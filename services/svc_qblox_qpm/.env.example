# Copy to .env beside this file, or point QBLOX_ENV_FILE at it.
#
# Everything is commented out, so a verbatim copy runs the dummy cluster and
# needs no hardware. Uncomment what you need.
#
# Parsing notes, because this is not python-dotenv:
#   - short names are mapped to their QBLOX_* equivalents, so this can be
#     spelled the way the Qblox notebooks do
#   - quoted values keep their contents; anything after the closing quote is
#     a comment
#   - None, null or empty means "not set" - for cluster_ip that selects
#     qblox-scheduler's built-in dummy cluster
#   - the real environment wins, so this file cannot override the service
#     manifest or device-access.yaml

# Address of the Qblox cluster. Omit, or set None, for the dummy cluster.
# cluster_ip = "192.168.0.2"
# cluster_name = "cluster_mm"

# Absolute paths, or bare names resolved against ./configs/.
# hardware_config = hw_cfg.json
# device_config = dev_cfg.json

# Record per-stage timings (schedule/compile/prepare/start/wait_done/
# retrieve_acquisition) and expose them through get_task_timing().
# profile_stages = 1

# Overrides. MAX_QUBITS otherwise comes from the element count in
# dev_cfg.json. TARGET_ID otherwise follows cluster_ip (qblox-cluster when
# set, qblox-dummy when not), and only needs setting if a site runs several
# Qblox services that need distinct ids.
# QFW_QBLOX_MAX_QUBITS = 3
# QFW_QBLOX_MAX_SHOTS = 10000
# QFW_QBLOX_TARGET_ID = qblox-cluster
