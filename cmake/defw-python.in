#!/usr/bin/env bash
set -euo pipefail

resolve_script_dir() {
	local source="$1"
	local dir

	while [[ -L "${source}" ]]; do
		dir="$(cd -P "$(dirname "${source}")" && pwd)"
		source="$(readlink "${source}")"
		[[ "${source}" == /* ]] || source="${dir}/${source}"
	done

	cd -P "$(dirname "${source}")" && pwd
}

prepend_path() {
	local var_name="$1"
	local path_value="$2"
	local current_value="${!var_name:-}"

	[[ -d "${path_value}" ]] || return 0
	case ":${current_value}:" in
		*":${path_value}:"*) return 0 ;;
	esac
	if [[ -n "${current_value}" ]]; then
		export "${var_name}=${path_value}:${current_value}"
	else
		export "${var_name}=${path_value}"
	fi
}

script_dir="$(resolve_script_dir "${BASH_SOURCE[0]}")"
if [[ -z "${_QFW_ACTIVE:-}" && -r "${script_dir}/qfw-activate" ]]; then
	# shellcheck source=/dev/null
	source "${script_dir}/qfw-activate" --qfw-no-args
fi

qfw_prefix="${QFW_PREFIX:-$(cd "${script_dir}/.." && pwd)}"
defw_prefix="${DEFW_PREFIX:-${qfw_prefix}}"

# DEFw's own launcher runs the Python: a script, a module with -m, or a
# service module with --serve. It runs the active interpreter, so a virtual
# environment's packages are on its path as they are.
launcher=""
for candidate in \
	"${defw_prefix}/bin/defw2-python" \
	"${qfw_prefix}/bin/defw2-python"; do
	if [[ -x "${candidate}" ]]; then
		launcher="${candidate}"
		break
	fi
done
# A build tree has no bin directory, and its activation puts the launcher
# on PATH.
if [[ ! -x "${launcher}" ]]; then
	launcher="$(command -v defw2-python || true)"
fi
if [[ ! -x "${launcher}" ]]; then
	echo "Unable to find the DEFw launcher, defw2-python, under ${defw_prefix}" >&2
	exit 127
fi

export DEFW_PATH="${DEFW_PATH:-${defw_prefix}}"
exec "${launcher}" "$@"
