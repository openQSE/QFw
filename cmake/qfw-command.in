#!/usr/bin/env bash
set -euo pipefail

resolve_script_dir() {
	local source="$1"
	local dir

	while [[ -L "${source}" ]]; do
		dir="$(cd -P "$(dirname "${source}")" && pwd)"
		source="$(readlink "${source}")"
		[[ "${source}" == /* ]] || source="${dir}/${source}"
	done

	cd -P "$(dirname "${source}")" && pwd
}

script_dir="$(resolve_script_dir "${BASH_SOURCE[0]}")"
if [[ -z "${_QFW_ACTIVE:-}" && -r "${script_dir}/qfw-activate" ]]; then
	# shellcheck source=/dev/null
	source "${script_dir}/qfw-activate" --qfw-no-args
fi

qfw_prefix="${QFW_PREFIX:-$(cd "${script_dir}/.." && pwd)}"
qfw_libexec="${QFW_LIBEXEC_DIR:-${qfw_prefix}/libexec/qfw}"
driver="${qfw_libexec}/qfw-setup-driver"

if [[ -x "${driver}" ]]; then
	exec "${driver}" "@QFW_COMMAND_NAME@" "$@"
fi

exec python3 -m qfw_runtime.commands "@QFW_COMMAND_NAME@" "$@"
