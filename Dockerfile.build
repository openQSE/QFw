# The Rocky Linux version. Used as the docker iamge tag.
# The 10.2 default can be replaced with --build-arg cmdline arg.
ARG ROCKYLINUX_TAG=10.2

FROM rockylinux/rockylinux:${ROCKYLINUX_TAG}

LABEL org.opencontainers.image.title="qfw-builder"
LABEL org.opencontainers.image.description="Build environment with slurm-devel and the QRMI/QDMI shim build toolchain"

# ARG REVISION
# ARG BUILD_DATE
# LABEL org.opencontainers.image.revision=$REVISION
# LABEL org.opencontainers.image.created=$BUILD_DATE

RUN set -ex \
    && dnf makecache \
    && dnf -y install dnf-plugins-core epel-release \
    && dnf config-manager --set-enabled crb \
    && dnf makecache \
    && dnf -y install --nobest --exclude='*.i686' \
    cmake \
    gcc \
    gcc-c++ \
    gcc-gfortran \
    git \
    make \
    openblas-devel \
    swig \
    && dnf clean all \
    && rm -rf /var/cache/dnf

# The top-level directory where all packages are installed
# Usually, it is /opt/qfw
ARG INSTALL_DIR

# ============================================================================
# Stage 2: Install QRMI
# ============================================================================

# The QRMI version (release tag) to use.
# Do not provide a default value to ensure explicit version is provided via
# the --build-arg during image build.
ARG QRMI_VERSION

RUN set -ex \
    && dnf -y install \
    curl \
    tar \
    && dnf clean all \
    && rm -rf /var/cache/dnf

# The TARGETARCH is a Docker BuildKit's automatic build argument.
# Used, among others, to determine the QRMI artifact flavor to download.
ARG TARGETARCH

# We need to download the correct TARGETARCH flavor of the QRMI tarball.
# So, detrmine the appropriate component of the artifact name based on the
# TARGETARCH as the QRMI_ARCH value. Then, resolve the full URL based on
# the provided QRMI_VERSION argument value.
# NOTE: The QRMI creates relese for RHEL8. We expect RockyLinux version 9
# or 10 (based on the ROCKYLINUX_TAG value), so hard-code "rl8" into the
# URL string when substituting the QRMI_ARCH and QRMI_VERSION.
RUN set -ex \
    && case "${TARGETARCH}" in \
    amd64) QRMI_ARCH=x86_64 ;; \
    arm64) QRMI_ARCH=aarch64 ;; \
    ppc64le) QRMI_ARCH=ppc64le ;; \
    *) echo "unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac \
    && mkdir -p "${INSTALL_DIR}/qrmi" \
    && curl -fsSL -o /tmp/qrmi.tar.gz \
    "https://github.com/qiskit-community/qrmi/releases/download/${QRMI_VERSION}/libqrmi-${QRMI_VERSION}-el8-${QRMI_ARCH}.tar.gz" \
    && tar -xzf /tmp/qrmi.tar.gz -C "${INSTALL_DIR}/qrmi" --strip-components=1 \
    && rm -f /tmp/qrmi.tar.gz

# ============================================================================
# Stage 3: Install QDMI
# ============================================================================

# The QDMI version (release tag) to use.
# Do not provide a default value to ensure explicit version is provided via
# the --build-arg during image build.
# Do not include the 'v' prefix, only the comma-separated numerals.
ARG QDMI_VERSION

# QDMI ships no prebuilt release artifacts (it's a header-only interface
# library), so unlike QRMI above we build and install it from source with
# CMake. Tests, examples, templates, and docs are disabled: they aren't
# needed to install the qdmi::qdmi interface library and would otherwise
# pull in extra dependencies (e.g. GoogleTest, Doxygen) fetched over the
# network during the CMake configure step.
RUN set -ex \
    && git clone --depth 1 --branch "v${QDMI_VERSION}" \
    https://github.com/Munich-Quantum-Software-Stack/QDMI.git /tmp/qdmi \
    && cmake -S /tmp/qdmi -B /tmp/qdmi/build \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX="${INSTALL_DIR}/qdmi" \
    -DINSTALL_QDMI=ON \
    -DBUILD_QDMI_TESTS=OFF \
    -DBUILD_QDMI_EXAMPLES=OFF \
    -DBUILD_QDMI_TEMPLATES=OFF \
    -DBUILD_QDMI_DOCS=OFF \
    && cmake --build /tmp/qdmi/build --target install \
    && rm -rf /tmp/qdmi

CMD ["sleep", "infinity"]
